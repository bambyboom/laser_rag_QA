# ===========================================================================
#  Laser RAG QA — Environment Configuration
#  ===========================================================================
#  Copy this file to .env and fill in the required values.
#    cp .env.example .env
#
#  Required:
#    • EMBEDDING_API_KEY  — API key for the embedding service (BGE-M3)
#    • LLM_API_KEY        — API key for the LLM service (DeepSeek / OpenAI)
#
#  Optional: all other variables have sensible defaults.
# ===========================================================================

# ===========================================================================
#  Embedding — BGE-M3 via OpenAI-compatible API
# ===========================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_TIMEOUT=60.0

# ===========================================================================
#  LLM / Generation — DeepSeek v4 Pro (or any OpenAI-compatible API)
# ===========================================================================
LLM_MODEL_NAME=deepseek-v4-pro
LLM_API_KEY=sk-xxxxxxxx
LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=120.0
# LLM_MAX_RETRIES=2

# ===========================================================================
#  Generator — answer generation model (may differ from reranker/rewriter)
# ===========================================================================
# GENERATOR_MODEL_NAME=gpt-4o

# ===========================================================================
#  ChromaDB — persistent vector store
# ===========================================================================
# CHROMA_PERSIST_DIR=./chroma_db
# CHROMA_COLLECTION_NAME=laser_knowledge

# ===========================================================================
#  Data & Documents
# ===========================================================================
# DATA_DIR=./data
# (Supported formats: .pdf, .docx, .txt, .md, .html)

# ===========================================================================
#  Text Cleaning
# ===========================================================================
# CLEANER_NOISE_PATTERNS=激光器选型手册,版本号,修订记录,第,页,Page,Revision,Confidential
# CLEANER_MIN_LINE_LENGTH=2
# CLEANER_MAX_CONSECUTIVE_BLANKS=1
# CLEANER_REMOVE_REPEATED_LINES=true
# CLEANER_REPEATED_LINE_RATIO=0.3

# ===========================================================================
#  Text Chunking
# ===========================================================================
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64

# ===========================================================================
#  Retrieval
# ===========================================================================
# RETRIEVAL_TOP_K=5
# RETRIEVAL_SIMILARITY_THRESHOLD=0.0
# RETRIEVAL_MAX_CHUNK_TOKENS=4096
# RETRIEVAL_HYBRID_RRF_K=60
# RETRIEVAL_HYBRID_EXPAND=3

# ===========================================================================
#  Reranker
# ===========================================================================
# RERANKER_ENABLED=true
# RERANKER_TOP_N=5
# RERANKER_MAX_CHUNK_CHARS=800

# ===========================================================================
#  Web Search  (DuckDuckGo via ddgs library)
# ===========================================================================
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_REGION=wt-wt
# WEB_SEARCH_TIMELIMIT=

# ===========================================================================
#  Routing
# ===========================================================================
# RERANK_KB_SUFFICIENT_THRESHOLD=7
# RERANK_RELEVANT_CHUNK_MIN=4
# RERANK_RELEVANT_CHUNK_COUNT=2
# RERANK_OUT_OF_DOMAIN_THRESHOLD=3

# ===========================================================================
#  OCR — Scanned PDF to text (Tesseract + PyMuPDF)
# ===========================================================================
# System dependency (install once):
#   sudo apt install tesseract-ocr tesseract-ocr-chi-sim
# OCR_ENABLED=true
# OCR_LANGUAGE=chi_sim+eng
# OCR_DPI=300
# OCR_FORCE=false            # force OCR even if pypdf got text
# OCR_MIN_TEXT_LENGTH=50     # trigger OCR if extracted text < this

# ===========================================================================
#  Prompt Templates (advanced — uncomment to customise)
# ===========================================================================
# RAG_SYSTEM_PROMPT=你是激光器行业知识库的专家助手...
# RAG_PROMPT_TEMPLATE=你是激光器行业知识库助手。请仅根据以下参考文档回答...
# GENERATION_MAX_CONTEXT_CHARS=6000

# ===========================================================================
#  Server
# ===========================================================================
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# SERVER_RELOAD=false
# CORS_ORIGINS=*

# ===========================================================================
#  Logging
# ===========================================================================
# LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s | %(levelname)-7s | %(name)s:%(lineno)d | %(message)s
